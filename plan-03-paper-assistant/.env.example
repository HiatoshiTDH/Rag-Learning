# Copy thành .env rồi điền — .env đã nằm trong .gitignore, không bao giờ commit key
# Các tổ hợp cấu hình sẵn (chất lượng cao / $0 toàn local / free API): SETUP.md mục 3b

ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...          # bỏ trống nếu EMBED_BACKEND=local

GROBID_URL=http://localhost:8070
QDRANT_URL=http://localhost:6333   # bỏ trống -> dùng Qdrant embedded tại data/qdrant (không cần docker)

# ---- Embedding / Rerank ----
# voyage (mặc định) | local (bge-m3/bge-reranker chạy máy, $0) | fake (test offline)
EMBED_BACKEND=voyage
RERANK_BACKEND=voyage          # voyage | local | fake | none

# ---- LLM ----
# anthropic (mặc định, có citations API) | openai_compat (Ollama/LM Studio/Groq/Gemini)
LLM_BACKEND=anthropic
# Chỉ cần khi LLM_BACKEND=openai_compat:
#OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1        # Ollama
#OPENAI_COMPAT_API_KEY=ollama
#OPENAI_COMPAT_MODEL=qwen2.5:14b

# ---- Ngôn ngữ TRẢ LỜI (tách biệt với ngôn ngữ câu hỏi) ----
# auto (mặc định, trả lời theo ngôn ngữ câu hỏi) | en | vi
# VD: hỏi tiếng Việt nhưng muốn nhận lại tiếng Anh (giữ thuật ngữ chuẩn cho viết
# paper/proposal) -> ANSWER_LANGUAGE=en. Ghi đè tạm thời qua CLI: --lang en/vi/auto
ANSWER_LANGUAGE=auto
