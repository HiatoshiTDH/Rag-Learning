# Copy thành .env rồi điền — .env đã nằm trong .gitignore, không bao giờ commit key

ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...          # bỏ trống nếu dùng phương án local-free (bge-m3)

GROBID_URL=http://localhost:8070
QDRANT_URL=http://localhost:6333   # bỏ trống -> dùng Qdrant embedded tại data/qdrant (không cần docker)

# voyage (mặc định) | fake (dev/test offline, không gọi API, không có ngữ nghĩa thật)
EMBED_BACKEND=voyage
