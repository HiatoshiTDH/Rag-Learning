# Copy to .env and fill in — .env is in .gitignore; never commit keys

ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...          # leave empty when using the local-free option (bge-m3)

GROBID_URL=http://localhost:8070
QDRANT_URL=http://localhost:6333   # leave empty -> embedded Qdrant at data/qdrant (no docker)

# voyage (default) | fake (offline dev/test, no API calls, no real semantics)
EMBED_BACKEND=voyage
