# Copy to .env and fill in the keys. Offline tests do NOT need this file.

ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# Backends: voyage|fake (embedding), anthropic|none (LLM).
# fake/none = run offline with no keys — dev/test.
EMBED_BACKEND=voyage
LLM_BACKEND=anthropic

# Qdrant: leave QDRANT_URL empty to use embedded mode (data/qdrant, no docker)
QDRANT_URL=
# QDRANT_URL=http://localhost:6333

# Models — defaults follow README section 5.1; override here if desired
# DIALOGUE_MODEL=claude-haiku-4-5
# SCORING_MODEL=claude-haiku-4-5
# REFLECTION_MODEL=claude-sonnet-5

# If dialogue isn't done within this many seconds -> canned fallback (the NPC never freezes)
DIALOGUE_TIMEOUT=10
