# Copy thành .env rồi điền key. Test offline KHÔNG cần file này.

ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# Backend: voyage|fake (embedding), anthropic|none (LLM).
# fake/none = chạy offline không key — dev/test.
EMBED_BACKEND=voyage
LLM_BACKEND=anthropic

# Qdrant: để trống QDRANT_URL thì dùng embedded mode (data/qdrant, không cần docker)
QDRANT_URL=
# QDRANT_URL=http://localhost:6333

# Models — mặc định theo README mục 5.1, đổi ở đây nếu muốn
# DIALOGUE_MODEL=claude-haiku-4-5
# SCORING_MODEL=claude-haiku-4-5
# REFLECTION_MODEL=claude-sonnet-5

# Quá số giây này chưa xong thoại -> canned fallback (NPC không đứng đơ)
DIALOGUE_TIMEOUT=10
