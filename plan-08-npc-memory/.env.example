# Copy thành .env — không commit key. Tổ hợp backend: SETUP.md mục 3

ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...              # bỏ trống nếu EMBED_BACKEND=local

QDRANT_URL=                        # bỏ trống -> embedded mode tại data/qdrant (không cần docker)
                                   # docker của plan này: http://localhost:6335

# voyage | local (bge-m3, $0) | fake (test)
EMBED_BACKEND=local

# anthropic | openai_compat (Ollama/LM Studio/Groq/Gemini) | fake (test)
LLM_BACKEND=anthropic
#OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
#OPENAI_COMPAT_API_KEY=ollama
#OPENAI_COMPAT_MODEL=qwen2.5:14b

# Trọng số retrieval 3 trục + ngưỡng reflection — tune bằng test harness
